{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "camera_config.schema.json",
  "title": "Camera Configuration",
  "description": "Configuration file defining cameras, zones, lines, operating hours, and tool slots",
  "type": "object",
  "patternProperties": {
    "^cam\\d+$": {
      "$ref": "#/$defs/camera"
    }
  },
  "properties": {
    "cameras": {
      "type": "object",
      "patternProperties": {
        "^cam\\d+$": {
          "$ref": "#/$defs/camera"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "camera": {
      "type": "object",
      "required": ["location", "source", "start_time"],
      "properties": {
        "location": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "start_time": { "type": "string", "format": "date-time" },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "p1", "p2", "in_normal"],
            "properties": {
              "id": { "type": "string" },
              "p1": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "p2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "in_normal": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
            }
          }
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "restricted", "polygon"],
            "properties": {
              "id": { "type": "string" },
              "restricted": { "type": "boolean" },
              "polygon": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 3
              }
            }
          }
        },
        "operating_hours": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["days", "start", "end"],
            "properties": {
              "days": {
                "type": "array",
                "items": { "type": "string", "enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] }
              },
              "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
              "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
            }
          }
        },
        "tool_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "roi", "t_present", "t_missing"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "roi": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
              "t_present": { "type": "number", "minimum": 0, "maximum": 1 },
              "t_missing": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}