{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "camera_config.schema.json",
  "title": "Camera Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["cameras"],
  "properties": {
    "cameras": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/camera"
      }
    }
  },
  "$defs": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "source", "start_time"],
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "lines": {
          "type": ["object", "null"],
          "properties": {
            "p1": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1000.0
            },
            "p2": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1000.0
            }
          },
          "required": ["p1", "p2"]
        },
        "zones": {
          "type": ["array", "null"],
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1000.0
            }
          },
          "minItems": 3
        },
        "operating_hours": {
          "type": ["object", "null"],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "end": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            }
          },
          "required": ["start", "end"]
        },
        "tool_slots": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_id"],
            "properties": {
              "tool_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
